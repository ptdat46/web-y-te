DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MYSQL_DATABASE=healthcare
MYSQL_USER=healthcare
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_PASSWORD=healthcare

# CORS origins for the frontend (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DRF_ANON_RATE=30/min
DRF_USER_RATE=300/min
DRF_AUTH_SENSITIVE_RATE=5/min
DRF_VERIFICATION_RATE=5/min

# Email (console backend for local; configure SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=no-reply@example.com
FRONTEND_URL=http://localhost:5173
AUTH_TOKEN_TTL_MINUTES=10

# Ollama (optional; chatbot falls back to mock replies when unreachable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=15

# Frontend API base URL
VITE_API_URL=http://localhost:5173/api/v1
